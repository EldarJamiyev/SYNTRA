{
  "schema_version": 1,
  "profile": "local-gpu-scale-context-1024",
  "corpus_root": ".",
  "checkpoint": "data/checkpoints/staging/gpu-scale/syntra-brain.pt",
  "curriculum": {
    "dataset": "data/curricula/gpu-scale/workspace-instructions.jsonl",
    "max_examples": 480,
    "max_tokens": 3000000
  },
  "pretraining": {
    "max_steps": 10000,
    "batch_size": 2,
    "gradient_accumulation_steps": 2,
    "block_size": 1024,
    "layers": 8,
    "heads": 8,
    "width": 256,
    "vocab_size": 1024,
    "dropout": 0.1,
    "learning_rate": 0.0003,
    "minimum_learning_rate": 0.00001,
    "warmup_steps": 200,
    "decay_steps": 10000,
    "weight_decay": 0.1,
    "evaluation_batches": 8,
    "tokenizer_bytes": 150000,
    "max_dataset_bytes": 268435456,
    "seed": 1337
  },
  "sft": {
    "steps": 3000,
    "batch_size": 2,
    "gradient_accumulation_steps": 2,
    "learning_rate": 0.00008
  },
  "evaluation": {
    "every_steps": 500,
    "device": "cpu",
    "isolation": "docker",
    "max_parallel": 1,
    "max_new_tokens": 512
  },
  "run_directory": "data/benchmarks/local-gpu-scale",
  "device": "auto"
}
