{
  "name": "syntra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "server": "node local/server.mjs",
    "cli": "node bin/syntra.mjs",
    "test": "node scripts/run-node-tests.mjs",
    "ai:install": "python scripts/setup_syntra_env.py",
    "ai:server": "python scripts/run_syntra_module.py server",
    "ai:cli": "python scripts/run_syntra_module.py cli",
    "benchmark": "node scripts/benchmark-agent.mjs",
    "benchmark:reports": "node scripts/benchmark-report.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.7.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "@playwright/test": "^1.64.1"
  }
}
